# 复制到 /etc/filesage/filesage.env 后按服务器实际路径修改。
FILESAGE_ROOT=/srv/filesage-files
FILESAGE_DATA_DIR=/var/lib/filesage
FILESAGE_WEB_DIR=/usr/local/lib/filesage/web
FILESAGE_LISTEN_ADDR=127.0.0.1:8080
FILESAGE_UPLOAD_MAX_BYTES=21474836480

# 使用浏览器主机名访问时，填写不带端口的主机名或 IP。
# FILESAGE_ALLOWED_HOSTS=filesage.example

# Agent 可选配置。不要把真实密钥写入此示例文件。
# FILESAGE_AGENT_BASE_URL=https://api.example/v1
# FILESAGE_AGENT_MODEL=model-name
# FILESAGE_AGENT_PROVIDER=openai-compatible
# FILESAGE_AGENT_API_KEY=replace-with-secret
